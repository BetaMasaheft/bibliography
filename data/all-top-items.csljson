	{
		"id": "http://zotero.org/groups/358366/items/FI3X6EGB",
		"type": "article-journal",
		"abstract": "The study is aimed at providing definitions for important terms that have specialized meaning in the Ethiopian manuscript culture. Terms related with lemmatized entry are also given under the same entry and marked as synonyms. The entries are arranged alphabetically following the Latin alphabetical order.",
		"container-title": "Aethiopica",
		"page": "145-162",
		"title": "Towards a Glossary of Ethiopian Manuscript Culture and Practice",
		"URL": "http://journals.sub.uni-hamburg.de/aethiopica/article/view/417",
		"volume": "14",
