				[
					"2006"
				]
			]
		}
	},
	{
		"id": "http://zotero.org/groups/358366/items/NGS8QU4A",
		"type": "article-journal",
		"abstract": "Anthropologists are increasingly using sociological methods in fieldwork; but when doing research in cultures other than their own, this will often impoverish their investigation, as they do not know the most revealing questions to ask. By keeping an open mind, surprising information may unexpectedly turn up. This is, e.g., the case when investigating the situation of women, where it may be necessary to conduct studies in indirect ways, in combination with more factual statistical data collection.        ATTENTION: Due to copy-right no online publication is provided.",
		"container-title": "Aethiopica",
		"page": "115-143",
		"title": "Fieldwork, Serendipity, and Ethiopian Women",
		"URL": "http://journals.sub.uni-hamburg.de/aethiopica/article/view/197",
