		"container-title": "Recht in Afrika",
		"page": "51–90",
		"title": "Strengthening and Capacity Building of the Regional Judiciary in Ethiopia",
		"volume": "1999/1",
		"author": [
			{
				"family": "Scholler",
				"given": "Heinrich"
			}
		],
