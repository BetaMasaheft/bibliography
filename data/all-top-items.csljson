		}
	},
	{
		"id": "http://zotero.org/groups/358366/items/IFUAGQHR",
		"type": "article-journal",
		"container-title": "Aethiopica",
		"page": "193-200",
		"title": "Tewodros Bomba: Discovery of an Unpublished Letter from Aṣe Tewodros to “Ǝtege” Yätämäññu",
		"URL": "http://journals.sub.uni-hamburg.de/aethiopica/article/view/47",
		"volume": "13",
		"author": [
