		"ISSN": "0066-2127",
		"page": "45-67",
		"title": "Feasting and Political Change: Tafari's Ascent to Power and Early 20th century geber",
		"URL": "http://www.persee.fr/doc/ethio_0066-2127_2013_num_28_1_1529",
		"volume": "28",
